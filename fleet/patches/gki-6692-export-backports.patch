@@ -3453,6 +3453,7 @@ static int f2fs_ioc_set_pin_file(struct file *filp, unsigned long arg)
 	struct f2fs_sb_info *sbi = F2FS_I_SB(inode);
 	__u32 pin;
 	int ret = 0;
+	bool allow_pin_big_file = false;
 
 	if (get_user(pin, (__u32 __user *)arg))
 		return -EFAULT;
@@ -3485,7 +3486,9 @@ static int f2fs_ioc_set_pin_file(struct file *filp, unsigned long arg)
